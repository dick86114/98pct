# ============================================================
# 今天发什么发版管理平台 - 环境变量配置模板
# 版本：v3.0.0
# 更新日期：2025-01-20
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置项
# 3. 不要将 .env 文件提交到版本控制系统
# ============================================================

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接字符串
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 
# 示例：
# - 本地开发：postgresql://postgres:password@localhost:5432/release_platform
# - Docker 容器：postgresql://postgres:password@host.docker.internal:5432/release_platform
# - 远程服务器：postgresql://postgres:password@192.168.1.100:5432/release_platform
DATABASE_URL="postgresql://postgres:password@localhost:5432/release_platform"

# ==================== 安全配置 ====================
# JWT 密钥（用于用户认证和 token 签名）
# 重要：请务必修改为随机字符串，建议至少 32 位
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secret-key-please-change-this-to-random-string"

# ==================== 应用配置 ====================
# Next.js 运行端口（默认 3000）
# PORT=3000

# 主机名（默认 0.0.0.0，允许外部访问）
# HOSTNAME="0.0.0.0"

# Node 环境（development/production）
# NODE_ENV=production

# 禁用 Next.js 遥测数据收集
# NEXT_TELEMETRY_DISABLED=1

# ==================== 文件上传配置 ====================
# 上传文件大小限制（单位：MB，默认 10MB）
# MAX_FILE_SIZE=10

# 上传文件存储路径（相对于 public 目录）
# UPLOAD_DIR=uploads

# ==================== 日志配置 ====================
# 日志级别（debug/info/warn/error）
# LOG_LEVEL=info

# ==================== 其他配置 ====================
# 会话超时时间（单位：小时，默认 24 小时）
# SESSION_TIMEOUT=24

# 分页大小（默认 20）
# PAGE_SIZE=20
